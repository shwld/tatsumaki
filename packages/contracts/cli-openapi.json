{
  "openapi": "3.0.3",
  "info": {
    "title": "tatsumaki CLI API",
    "version": "0.0.11"
  },
  "components": {
    "schemas": {
      "ArtifactError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "EMPTY_MANIFEST",
              "INVALID_PATH",
              "DUPLICATE_PATH",
              "SENSITIVE_FILE",
              "INVALID_SIZE",
              "INVALID_SHA256",
              "INVALID_ENTRYPOINT",
              "FORBIDDEN",
              "ARTIFACT_NOT_FOUND",
              "VERSION_NOT_FOUND",
              "FILE_NOT_FOUND",
              "SESSION_NOT_FOUND",
              "BASE_VERSION_CONFLICT",
              "PUBLISH_CONFLICT",
              "SESSION_NOT_PENDING",
              "UPLOAD_INCOMPLETE",
              "SESSION_EXPIRED",
              "TOO_MANY_FILES",
              "FILE_TOO_LARGE",
              "TOTAL_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "IDEMPOTENCY_KEY_REUSED",
              "TREE_DIGEST_MISMATCH",
              "FILE_NOT_IN_MANIFEST",
              "FILE_SIZE_MISMATCH",
              "FILE_DIGEST_MISMATCH",
              "STORAGE_ERROR",
              "INTERNAL_ERROR",
              "NOT_FOUND"
            ]
          }
        },
        "required": ["error", "code"]
      },
      "StoryGetResponse": {
        "type": "object",
        "properties": {
          "story": {
            "$ref": "#/components/schemas/Story"
          }
        },
        "required": ["story"]
      },
      "Story": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StorySummary"
          },
          {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "example": "## Plan\n..."
              },
              "statusChangedAt": {
                "type": "string"
              },
              "completedAt": {
                "type": "string",
                "nullable": true
              },
              "storyPoint": {
                "type": "integer",
                "nullable": true
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "epicId": {
                "type": "string",
                "nullable": true
              },
              "iterationId": {
                "type": "string",
                "nullable": true
              },
              "isIcebox": {
                "type": "boolean"
              },
              "ownerIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requesterId": {
                "type": "string",
                "nullable": true
              },
              "releaseDate": {
                "type": "string",
                "nullable": true
              },
              "position": {
                "type": "number"
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              },
              "isBlocked": {
                "type": "boolean"
              },
              "isBlocking": {
                "type": "boolean"
              },
              "blockingStories": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StoryRelation"
                }
              },
              "blockedStories": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StoryRelation"
                }
              }
            },
            "required": [
              "projectId",
              "description",
              "statusChangedAt",
              "completedAt",
              "storyPoint",
              "labels",
              "epicId",
              "iterationId",
              "isIcebox",
              "ownerIds",
              "requesterId",
              "releaseDate",
              "position",
              "createdAt",
              "updatedAt"
            ]
          }
        ]
      },
      "StoryRelation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["id", "title"]
      },
      "StorySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "01KNCFJZJ0Z74X92QPCE0D9MK8"
          },
          "storyNumber": {
            "type": "number",
            "example": 95
          },
          "title": {
            "type": "string",
            "example": "CLIを用意する"
          },
          "status": {
            "type": "string",
            "example": "Started"
          },
          "type": {
            "type": "string",
            "example": "feature"
          }
        },
        "required": ["id", "storyNumber", "title", "status", "type"]
      },
      "StoryListResponse": {
        "type": "object",
        "properties": {
          "stories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorySummary"
            }
          }
        },
        "required": ["stories"]
      },
      "StoryStatus": {
        "type": "string",
        "enum": [
          "Unstarted",
          "Started",
          "Finished",
          "Delivered",
          "Accepted",
          "Rejected"
        ],
        "example": "Unstarted"
      },
      "ProjectGetResponse": {
        "type": "object",
        "properties": {
          "project": {
            "$ref": "#/components/schemas/Project"
          }
        },
        "required": ["project"]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "01KN9P32R248P2PK1413DKQQG5"
          },
          "name": {
            "type": "string",
            "example": "tatsumaki"
          }
        },
        "required": ["id", "name"]
      },
      "CliVersionCompatibilityResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "example": "0.0.11"
          },
          "minClientVersion": {
            "type": "string",
            "example": "0.0.11"
          }
        },
        "required": ["apiVersion", "minClientVersion"]
      },
      "CliWhoamiResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "01KN9P32R248P2PK1413DKQQG5"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Taro"
          }
        },
        "required": ["id", "email", "displayName"]
      },
      "ArtifactListResponse": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          }
        },
        "required": ["artifacts"]
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "01KNCFJZJ0Z74X92QPCE0D9MK8"
          },
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "archivedAt": {
            "type": "string",
            "nullable": true
          },
          "latestVersion": {
            "type": "integer",
            "nullable": true
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "projectId",
          "title",
          "archivedAt",
          "latestVersion",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "ArtifactDetailResponse": {
        "type": "object",
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/Artifact"
          },
          "latestVersion": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ArtifactVersion"
              },
              {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ArtifactFile"
                    }
                  }
                },
                "required": ["files"],
                "nullable": true
              }
            ]
          }
        },
        "required": ["artifact", "latestVersion"]
      },
      "ArtifactFile": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          }
        },
        "required": ["path", "size", "sha256", "contentType"]
      },
      "ArtifactVersion": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "entrypoint": {
            "type": "string"
          },
          "treeDigest": {
            "type": "string"
          },
          "fileCount": {
            "type": "integer"
          },
          "totalBytes": {
            "type": "integer"
          },
          "sessionId": {
            "type": "string",
            "nullable": true
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "artifactId",
          "version",
          "entrypoint",
          "treeDigest",
          "fileCount",
          "totalBytes",
          "sessionId",
          "createdBy",
          "createdAt"
        ]
      },
      "ArtifactResponse": {
        "type": "object",
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/Artifact"
          }
        },
        "required": ["artifact"]
      },
      "ArtifactVersionListResponse": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactVersion"
            }
          }
        },
        "required": ["versions"]
      },
      "ArtifactVersionDetailResponse": {
        "type": "object",
        "properties": {
          "version": {
            "$ref": "#/components/schemas/ArtifactVersion"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactFile"
            }
          }
        },
        "required": ["version", "files"]
      },
      "ArtifactUploadCreateResponse": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ArtifactUploadSession"
          },
          {
            "$ref": "#/components/schemas/ArtifactUploadNoop"
          }
        ]
      },
      "ArtifactUploadSession": {
        "type": "object",
        "properties": {
          "noop": {
            "type": "boolean",
            "enum": [false]
          },
          "sessionId": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          },
          "baseVersion": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["pending", "published", "expired"]
          },
          "expiresAt": {
            "type": "string"
          },
          "uploadedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "noop",
          "sessionId",
          "artifactId",
          "baseVersion",
          "status",
          "expiresAt",
          "uploadedPaths"
        ]
      },
      "ArtifactUploadNoop": {
        "type": "object",
        "properties": {
          "noop": {
            "type": "boolean",
            "enum": [true]
          },
          "artifactId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": ["noop", "artifactId", "version"]
      },
      "ArtifactUploadCreateBody": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ArtifactUploadNewBody"
          },
          {
            "$ref": "#/components/schemas/ArtifactUploadUpdateBody"
          }
        ]
      },
      "ArtifactUploadNewBody": {
        "type": "object",
        "properties": {
          "entrypoint": {
            "type": "string"
          },
          "treeDigest": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": ["path", "size", "sha256"]
            }
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["entrypoint", "treeDigest", "files", "title"]
      },
      "ArtifactUploadUpdateBody": {
        "type": "object",
        "properties": {
          "entrypoint": {
            "type": "string"
          },
          "treeDigest": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": ["path", "size", "sha256"]
            }
          },
          "artifactId": {
            "type": "string"
          },
          "baseVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "entrypoint",
          "treeDigest",
          "files",
          "artifactId",
          "baseVersion"
        ]
      },
      "ArtifactFinalizeResponse": {
        "type": "object",
        "properties": {
          "noop": {
            "type": "boolean",
            "enum": [false]
          },
          "artifactId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": ["noop", "artifactId", "version"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/programmatic-api/v1/projects/{projectId}/stories/{storyNumber}": {
      "get": {
        "operationId": "getStoryByNumber",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "95"
            },
            "required": true,
            "name": "storyNumber",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Story found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryGetResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Story not found"
          }
        }
      },
      "patch": {
        "operationId": "updateStory",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "95"
            },
            "required": true,
            "name": "storyNumber",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bug", "chore", "release"]
                  },
                  "storyPoint": {
                    "type": "integer",
                    "nullable": true
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "isIcebox": {
                    "type": "boolean"
                  },
                  "status": {
                    "$ref": "#/components/schemas/StoryStatus"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Story updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryGetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Story not found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/programmatic-api/v1/projects/{projectId}/stories": {
      "get": {
        "operationId": "listStories",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/StoryStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": ["current"],
              "example": "current"
            },
            "required": false,
            "name": "iterationDateScope",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "example": "10"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Stories matching the filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "post": {
        "operationId": "createStory",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bug", "chore", "release"]
                  },
                  "description": {
                    "type": "string"
                  },
                  "isIcebox": {
                    "type": "boolean"
                  }
                },
                "required": ["title", "type", "description"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Story created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryGetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/programmatic-api/v1/projects/{projectId}/stories/reorder": {
      "post": {
        "operationId": "reorderStories",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderedIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": ["orderedIds"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stories reordered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/programmatic-api/v1/projects/{projectId}/stories/{storyNumber}/comments": {
      "post": {
        "operationId": "createStoryComment",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "95"
            },
            "required": true,
            "name": "storyNumber",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["body"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comment created"
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Story not found"
          }
        }
      }
    },
    "/programmatic-api/v1/projects/{projectId}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "project-123"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Project found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectGetResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/programmatic-api/v1/version": {
      "get": {
        "operationId": "getCliVersionCompatibility",
        "responses": {
          "200": {
            "description": "CLI compatibility versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CliVersionCompatibilityResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/programmatic-api/v1/whoami": {
      "get": {
        "operationId": "getCliWhoami",
        "responses": {
          "200": {
            "description": "Current CLI user",
